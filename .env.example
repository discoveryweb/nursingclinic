# -----------------------------------------------------------------------------
# کلینیک پرستاری آرامش - متغیرهای محیطی استقرار (Runflare / Production)
# -----------------------------------------------------------------------------

# ۱. اتصال به دیتابیس PostgreSQL (در Runflare در بخش دیتابیس یا سرویس مدیریت‌شده ساخته می‌شود)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ۲. کلید محرمانه HMAC سرور برای کدهای یک‌بارمصرف ورود (حداقل ۳۲ کاراکتر تصادفی)
# تولید با دستور: openssl rand -hex 32
OTP_SECRET=

# ۳. تنظیمات سامانه پیامک ملی‌پیامک (Melipayamak) - ارائه‌دهندهٔ اصلی و پیش‌فرض
# از پنل کاربری ملی‌پیامک (melipayamak.com)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=50004
# اختیاری: شناسه عددی قالب خدماتی اعتبارسنجی ملی‌پیامک برای عبور از بلک‌لیست مخابرات
MELIPAYAMAK_OTP_BODY_ID=

# ۴. تنظیمات کمکی کاوه‌نگار (در صورت استفاده به عنوان درگاه ثانویه اختیاری)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_VERIFY_TEMPLATE=

# ۵. حالت اطلاعات نمونه متخصصان (پس از درج مشخصات واقعی، مقدار را false قرار دهید)
CLINIC_DEMO_MODE=true

# ۶. محدودسازی فریم در پروداکشن (برای امنیت و جلوگیری از Clickjacking)
# CLINIC_FRAME_ANCESTORS="'self'"

# ۷. ایجاد اولین مدیر ارشد سیستم (فقط یک‌بار هنگام ساخت دیتابیس اولیه بررسی می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
